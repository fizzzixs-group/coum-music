{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coum Music",
  "version": "0.1.0",
  "identifier": "com.coum.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coum Music",
        "width": 1320,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#08080B",
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  }
}
